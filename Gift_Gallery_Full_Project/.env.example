# =============================================================
# Gift Gallery — Environment Variables (.env.example)
# لا تضع أي بيانات اعتماد حقيقية هنا أو في ملفات الواجهة الأمامية
# =============================================================

# 1. إعدادات مستودع GitHub لتخزين الكتالوج والملفات (اختياري محلياً، أساسي على Vercel)
GITHUB_TOKEN=github_pat_REPLACE_ME
GITHUB_OWNER=your-github-username
GITHUB_REPO=gift-gallery-data
GITHUB_BRANCH=main
GITHUB_DATA_PATH=data/gifts.json
GITHUB_ASSETS_PATH=public/assets

# 2. حساب خدمة Firebase Admin للتحقق من هوية المسؤول على الخادم (JSON في سطر واحد)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"REPLACE_ME"}

# 3. قائمة بريد المسؤولين المصرح لهم (مفصولة بفواصل)
ADMIN_EMAILS=you@example.com

# 4. الحد الأقصى لحجم الرفع بالميجابايت (4MB مناسب لـ Vercel Serverless، أو حتى 30MB محلياً)
MAX_UPLOAD_MB=30

# 5. رابط Vercel Deploy Hook اختياري لإعادة النشر التلقائي عند التحديث
VERCEL_DEPLOY_HOOK_URL=
