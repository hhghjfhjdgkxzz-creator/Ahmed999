# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Gift Gallery — Admin & Security Settings
# ==========================================
# كلمة المرور الأولية للوحة التحكم (تُستخدم عند عدم وجود تغيير محفوظ، ويُنصح بتغييرها فور الإعداد)
ADMIN_INITIAL_PASSWORD="150150"
# مفتاح توقيع جلسات المدير (Session Secret)
ADMIN_SESSION_SECRET="replace_with_secure_random_secret_string_64_chars"
# الحد الأقصى لحجم الملف الواحد بالميجابايت (الافتراضي: 100MB)
MAX_UPLOAD_FILE_SIZE_MB="100"

# ==========================================
# Cloudflare R2 Object Storage (No-Database Permanent Storage)
# ==========================================
# معرّف حساب Cloudflare (Account ID)
R2_ACCOUNT_ID=""
# مفتاح الوصول (Access Key ID) لـ Cloudflare R2 API
R2_ACCESS_KEY_ID=""
# المفتاح السري (Secret Access Key) لـ Cloudflare R2 API
R2_SECRET_ACCESS_KEY=""
# اسم الـ Bucket في Cloudflare R2 (مثال: gift-gallery-storage)
R2_BUCKET_NAME=""
# رابط الـ CDN أو الدومين العام للوصول للملفات مباشرة (اختياري، مثال: https://pub-xxx.r2.dev)
R2_PUBLIC_BASE_URL=""

# ==========================================
# Optional GitHub Catalog Backup (Server-Side Only)
# ==========================================
GITHUB_TOKEN=""
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
GITHUB_CATALOG_PATH="catalog/gifts.json"
